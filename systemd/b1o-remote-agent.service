[Unit]
Description=b1o Remote Agent
After=graphical-session.target

[Service]
Type=simple
WorkingDirectory=%h/Загрузки/b1o-remote-agent
EnvironmentFile=%h/Загрузки/b1o-remote-agent/.env
ExecStart=%h/Загрузки/b1o-remote-agent/.venv/bin/uvicorn agent.main:app --host 127.0.0.1 --port 8765
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
