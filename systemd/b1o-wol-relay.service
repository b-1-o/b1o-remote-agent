[Unit]
Description=b1o Wake-on-LAN Relay
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/Загрузки/b1o-remote-agent
EnvironmentFile=%h/Загрузки/b1o-remote-agent/.env
ExecStart=%h/Загрузки/b1o-remote-agent/.venv/bin/python -m relay.wol_relay
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
